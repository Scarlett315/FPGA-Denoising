# Go Board (iCE40 HX1K, VQ100) pin constraints for denoiser_system
# Pin numbers are from Nandland's Go_Board_Pin_Constraints.pcf (getting-started-with-fpgas repo)

# 25 MHz clock
set_io i_Clk 15

# Push buttons (pressed = 1)
set_io i_Switch_1 53
set_io i_Switch_2 51
set_io i_Switch_3 54
set_io i_Switch_4 52

# LEDs
set_io o_LED_1 56
set_io o_LED_2 57
set_io o_LED_3 59
set_io o_LED_4 60

# 7-segment displays (active low at the pin)
set_io o_Segment1_A 3
set_io o_Segment1_B 4
set_io o_Segment1_C 93
set_io o_Segment1_D 91
set_io o_Segment1_E 90
set_io o_Segment1_F 1
set_io o_Segment1_G 2
set_io o_Segment2_A 100
set_io o_Segment2_B 99
set_io o_Segment2_C 97
set_io o_Segment2_D 95
set_io o_Segment2_E 94
set_io o_Segment2_F 8
set_io o_Segment2_G 96

# PMOD: mic on the top row (Pmod pins 1-3), audio out on the bottom row (Pmod pin 8)
#   Pmod 1 -> INMP441 SCK   (FPGA output)
#   Pmod 2 -> INMP441 WS    (FPGA output)
#   Pmod 3 <- INMP441 SD    (FPGA input)
#   Pmod 5 = GND, Pmod 6 = VCC (mic power; check the voltage on your board)
#   Pmod 8 -> audio filter input (the VPWM net in the schematic)
set_io o_Mic_SCK  65
set_io o_Mic_WS   64
set_io i_Mic_SD   63
set_io o_Audio_Out 79


